+
+    if MODS_DIR.is_dir():
+        for mod in sorted(p for p in MODS_DIR.iterdir() if p.is_dir()):
+            if not (mod / "000info").is_dir():
+                print(f"      skipping mods/{mod.name}: no 000info folder (not an unpacked package)")
+                continue
+            if mod.name in skipped:
+                print(f"      MOD: {mod.name} - LEFT OUT, its code could not be recompiled "
+                      f"(see {DLC_SKIPPED.relative_to(ROOT)})")
+                continue
+            out_dir = DLC_ASSETS / mod.name
+            if out_dir.exists():
+                shutil.rmtree(out_dir)
+            shutil.copytree(mod, out_dir)
+            count = 0
+            for dll in sorted(out_dir.rglob("*")):
+                if not dll.is_file() or dll.suffix.lower() != ".dll":
+                    continue
+                guest = dll.relative_to(out_dir).as_posix().lower()
+                if guest in known:
+                    print(f"      warning: mods/{mod.name}: {guest} is already provided by "
+                          "another package; the game refuses a second copy")
+                    continue
+                known.add(guest)
+                modules.append((guest, dll.relative_to(ROOT).as_posix(), dll.stem))
+                count += 1
+            print(f"      MOD: {mod.name} ({count} code modules)")
+            included.append(mod.name)
 
